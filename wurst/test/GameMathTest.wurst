package GameMathTest
import GameMath
import LinkedList

// Run with the Wurst "Run unit tests" command (or `wurst tests`).
// These cover the pure logic extracted into GameMath; the rest of the codebase is
// coupled to WC3 natives and must be verified in-game.

@Test function falloffWithinMinIsFull()
  blastFalloff(0., 100., 300.).assertEquals(1., 0.0001)
  blastFalloff(100., 100., 300.).assertEquals(1., 0.0001)

@Test function falloffMidpointIsHalf()
  blastFalloff(200., 100., 300.).assertEquals(0.5, 0.0001)

@Test function falloffAtAndBeyondMaxIsZero()
  blastFalloff(300., 100., 300.).assertEquals(0., 0.0001)
  blastFalloff(400., 100., 300.).assertEquals(0., 0.0001)

@Test function falloffEqualRadiiDoesNotDivideByZero()
  // The ClusterBomb misuse passed minRadius as both args; this must stay finite.
  blastFalloff(50., 125., 125.).assertEquals(1., 0.0001)
  blastFalloff(125., 125., 125.).assertEquals(1., 0.0001)
  blastFalloff(200., 125., 125.).assertEquals(0., 0.0001)

@Test function weightedPickHitsCorrectBuckets()
  let weights = new LinkedList<int>()
  weights.add(10)
  weights.add(10)
  weights.add(10)
  pickWeightedIndex(weights, 0).assertEquals(0)
  pickWeightedIndex(weights, 9).assertEquals(0)
  pickWeightedIndex(weights, 10).assertEquals(1)
  pickWeightedIndex(weights, 19).assertEquals(1)
  pickWeightedIndex(weights, 20).assertEquals(2)
  pickWeightedIndex(weights, 29).assertEquals(2)
  pickWeightedIndex(weights, 30).assertEquals(-1)
  destroy weights

@Test function weightedPickSkipsZeroWeights()
  // A weapon with rarity/weight 0 must never be selected.
  let weights = new LinkedList<int>()
  weights.add(0)
  weights.add(5)
  pickWeightedIndex(weights, 0).assertEquals(1)
  pickWeightedIndex(weights, 4).assertEquals(1)
  destroy weights

@Test function bonusDecompositionSplitsIntoPowersOfTwo()
  // 5 = 2^2 + 2^0
  bonusBits(5.).assertEquals(5)

@Test function bonusDecompositionCoversFullRange()
  // 65535 = sum of 2^0..2^15 — every one of the 16 bonus abilities
  bonusBits(65535.).assertEquals(65535)

@Test function bonusDecompositionCapsAtSixteenBits()
  // Values beyond the 16 abilities saturate instead of spilling into bit 16.
  bonusBits(70000.).assertEquals(65535)

@Test function bonusDecompositionZeroAndNegativeAreEmpty()
  // Documents current Status behavior: a negative bonus total applies nothing.
  bonusBits(0.).assertEquals(0)
  bonusBits(-5.).assertEquals(0)

@Test function bonusDecompositionDropsFractions()
  // 2.5 applies only the 2^1 ability; the 0.5 remainder is silently dropped.
  bonusBits(2.5).assertEquals(2)

@Test function weightedPickFavoursHeavierWeight()
  // rarity 100 (common) should dominate rarity 1 (legendary)
  let weights = new LinkedList<int>()
  weights.add(1)
  weights.add(100)
  pickWeightedIndex(weights, 0).assertEquals(0)
  pickWeightedIndex(weights, 1).assertEquals(1)
  pickWeightedIndex(weights, 100).assertEquals(1)
  destroy weights

// Equivalence: ground contact used to apply surface friction (x0.9) before the contact response.
// The response now sees the raw impact velocity and friction follows, with the thresholds
// rescaled; bounces must come out the same. The +0.0123 offsets keep speeds off the exact
// threshold, where rounding may tip either version.

/** Old sheep landing: friction first, then bounce back at half speed if falling faster than 3. */
function oldSheepLandingVelZ(real impactVelZ) returns real
  let felt = 0.9 * impactVelZ
  return felt < -3 ? -0.5 * felt : 0.

@Test function sheepLandingMatchesFrictionFirst()
  for i = 0 to 4000
    let v = -100. + i * 0.05 + 0.0123
    let newVelZ = SURFACE_FRICTION * bounceVelZ(v, SHEEP_BOUNCE_RESTITUTION, SHEEP_MIN_BOUNCE_SPEED)
    newVelZ.assertEquals(oldSheepLandingVelZ(v), 0.0001)

@Test function projectileBounceMatchesFrictionFirst()
  // MyProjectile.bounceOfGround: bounce when fast enough, scaling z by -c and xy by c.
  let velXY = 7.3
  for conservation in asList(0.5, 0.8)
    for i = 0 to 4000
      let v = -100. + i * 0.05 + 0.0123
      // Old: friction on every component, then the check on the reduced speed.
      let feltZ = 0.9 * v
      let oldBounces = feltZ.abs() > 6
      let oldZ = oldBounces ? -conservation * feltZ : feltZ
      let oldXY = oldBounces ? conservation * 0.9 * velXY : 0.9 * velXY
      // New: the check on the raw speed, the response, then friction.
      let newBounces = v.abs() > PROJECTILE_MIN_BOUNCE_SPEED
      let newZ = SURFACE_FRICTION * (newBounces ? -conservation * v : v)
      let newXY = SURFACE_FRICTION * (newBounces ? conservation * velXY : velXY)
      assertTrue(newBounces == oldBounces)
      newZ.assertEquals(oldZ, 0.0001)
      newXY.assertEquals(oldXY, 0.0001)

@Test function slowLandingStopsInsteadOfBouncing()
  bounceVelZ(-1., SHEEP_BOUNCE_RESTITUTION, SHEEP_MIN_BOUNCE_SPEED).assertEquals(0.)
  bounceVelZ(-10., 0.5, 3.).assertEquals(5.)

@Test function contactIsWhereTheMoveReachesTheGround()
  // 10 above, then 10 below: halfway.
  contactFraction(10., -10.).assertEquals(0.5, 0.0001)
  // 30 above, then 10 below: three quarters of the way.
  contactFraction(30., -10.).assertEquals(0.75, 0.0001)
  // Starting on the surface: contact at the start.
  contactFraction(0., -5.).assertEquals(0., 0.0001)

@Test function contactFractionStaysWithinTheMove()
  // Starting slightly below the surface can't place the contact before the move.
  contactFraction(-1., -5.).assertEquals(0., 0.0001)
  // No drop (not actually landing): the end of the move.
  contactFraction(5., 5.).assertEquals(1., 0.0001)

@Test function groundedUnitFollowsSlopesDown()
  assertTrue(staysGrounded(8., 0., UNIT_STICK_DISTANCE))
  assertTrue(staysGrounded(UNIT_STICK_DISTANCE, -1., UNIT_STICK_DISTANCE))

@Test function groundedBodyLeavesWhenLaunchedOrAtLedges()
  // Jump or knockback: moving up leaves the ground.
  assertTrue(not staysGrounded(2., 25., UNIT_STICK_DISTANCE))
  // A cliff level (128) is a ledge, not a slope.
  assertTrue(not staysGrounded(128., 0., UNIT_STICK_DISTANCE))
  // Projectiles don't stick (distance 0): rolling downhill makes them airborne, as before.
  assertTrue(not staysGrounded(3., 0., 0.))

@Test function cliffPushbackMatchesTheOldRule()
  // Old enforceCliffs: push back (ahead - z - 30) / 10 when the ground ahead is more than 30
  // above the unit, else no push. Only the look-ahead direction changed.
  for i = 0 to 300
    let groundAhead = -50. + i * 0.73
    let z = 20.
    let oldPush = groundAhead > z + 30 ? (groundAhead - z - 30) / 10 : 0.
    cliffPushback(groundAhead, z).assertEquals(oldPush, 0.0001)
