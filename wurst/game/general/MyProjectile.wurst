package MyProjectile
import Arsenal
import Assets
import ClosureForGroups
import ClosureTimers
import ConfigGame
import GameMath
import GroundContact
import HashSet
import Heightmap
import MyUnitEntity
import MySounds
import Projectile
import SheepEntity
import SoundUtils

public interface OnHit3Listener
  function run(MyUnitEntity target)

/** Live projectiles, so a blast can find the explosives it sets off. */
constant liveProjectiles = new HashSet<MyProjectile>

init
  onBlastArea() (blastPos, maxRadius) ->
    detonateInRange(blastPos, maxRadius)

function detonateInRange(vec3 blastPos, real maxRadius)
  for p in liveProjectiles
    if p.detonatable and not p.done and not p.detonating and blastPos.distanceTo(p.pos) < maxRadius
      p.detonate()

/** One-shot timer owned by a projectile: fires the action unless the projectile is destroyed first. */
class ProjectileTimer extends CallbackSingle
  MyProjectile owner
  Callback action

  construct(MyProjectile owner, Callback action)
    this.owner = owner
    this.action = action

  override function call()
    owner.onTimerFired(this)
    action.call()

  ondestroy
    destroy action

public class MyProjectile extends Projectile
  use GroundContactModule

  private constant hitGroup3 = new HashSet<MyUnitEntity>
  // Timers started through doAfterAlive/doPeriodicallyAlive; cancelled in ondestroy so
  // their closures never run on a destroyed (possibly recycled) projectile.
  private constant pendingTimers = new HashSet<CallbackSingle>
  private constant pendingPeriodics = new HashSet<CallbackPeriodic>
  
  private OnHit3Listener onHit3 = null
  var friendlyFire = false
  var maxHits = 1
  /** Goes off when caught in someone else's blast. */
  var detonatable = false
  var detonating = false
  
  real distance = 0.

  real firingPower
  SheepEntity source
  bool isInWater = false
  real conservationBounce = 0.5
  SoundDefinition soundBounce = SOUND_BOUNCE_METAL

  construct(SheepEntity source, real radius, string fxpath)
    super(source.pos, radius, source.owner, source.actor.getFacingAngle(), fxpath)
    gravity = defaultGravity
    this.source = source
    fx.eff.setScale(PROJECTILE_DEFAULT_SCALE)
    firingPower = owner.getFiringPower(2)
    setPhysics()
    liveProjectiles.add(this)

  function setPermanent()
    this.maxHits = INT_MAX

  /** Blows up a frame from now, through the weapon's own onEnd, so the explosion that set this
      off can't set it off again and a chain reaction spreads out over frames. */
  function detonate()
    detonating = true
    doAfterAlive(0) ->
      // It may have gone off by itself in the meantime.
      if not done
        terminate()

  /** doAfter that is cancelled if this projectile is destroyed first. */
  function doAfterAlive(real timeToWait, Callback action)
    pendingTimers.add(doAfter(timeToWait, new ProjectileTimer(this, action)))

  /** doPeriodically that is cancelled if this projectile is destroyed first.
      End it with stopTimer(cb), not destroy cb. */
  function doPeriodicallyAlive(real interval, CallbackPeriodic cb)
    pendingPeriodics.add(doPeriodically(interval, cb))

  function stopTimer(CallbackPeriodic cb)
    pendingPeriodics.remove(cb)
    destroy cb

  function onTimerFired(CallbackSingle cb)
    pendingTimers.remove(cb)

  function scaleVelXY(real scaling)
    vel.x = scaling * vel.x
    vel.y = scaling * vel.y

  function scaleVelZ(real scaling)
    vel.z = scaling * vel.z

  function onHit3D(OnHit3Listener listener)
    this.onHit3 = listener
    
  function checkHit3(unit u)
    let target = u.getMyUnitEntity()
    // Dummy units (arsenal, InstantDummyCaster) have no entity.
    if target == null
      return
    // The hitbox grows with the target, so a swollen sheep can be hit from further out.
    let hitDistance = hitRadius(radius, target.scale, SHEEP_SCALING_VALUE, SHEEP_HIT_RADIUS_GROWTH)
    // Sheep in heaven are not solid.
    if (not target.isSheep() or target.toSheep().isAlive()) and pos.distanceTo(target.pos) < hitDistance
      if not hitGroup3.has(target)
        if target.owner != owner or friendlyFire
          hit3(target)

  function removeHitUnit(MyUnitEntity e)
    // Remove unconditionally: a destroyed entity's id can be recycled, and a
    // stale entry would block hits on whatever entity inherits that id.
    hitGroup3.remove(e)

  function setPhysics()
    let power = PROJECTILE_POWER_FACTOR * firingPower + PROJECTILE_BASE_POWER
    setSpeed(power)
    vel.z = PROJECTILE_FACTOR_Z * power
  
  override function update()
    let start = pos
    if not done
      distance += vel.length()
      updateAirFriction()
      checkFriendlyFire()
      enforceWater()

    if not done
      checkCollision()
    if not done
      super.update()
    if not done
      updateGroundContact(this, start)

  function updateAirFriction()
    scaleVel(1 - 0.005 * PROJECTILE_AIR_FRICTION)

  private function checkFriendlyFire()
    if not friendlyFire and isAwayFromSource()
      friendlyFire = true

  private function isAwayFromSource() returns bool
    return source.pos.distanceTo2d(pos) > radius + 100

  function enforceWater()
    if isInWater
      if pos.z > terrainZ or not pos.toVec2().isTerrainWater()
        isInWater = false
        onExitWater()
    else
      // At or below the surface: a landing (placed exactly on it) counts as touching the water.
      if pos.z <= terrainZ and pos.toVec2().isTerrainWater()
        isInWater = true
        onEnterWater()

  override function onGroundHit()
    // Landing is resolved after the move, so update the water state before subclasses react
    // (a Molotov landing in water must sizzle out, not explode).
    enforceWater()

  function onEnterWater()
    SOUNDS_WATER_ENTER.getRandomElement().playOnPoint(pos)
    flashEffect(Abilities.crushingWaveDamage, pos)

  function onExitWater()
    SOUNDS_WATER_EXIT.getRandomElement().playOnPoint(pos)
    flashEffect(Abilities.crushingWaveDamage, pos)

  /** Widest a hitbox can grow: covers a sheep swollen to several times its base size.
      The exact per-target distance is checked in checkHit3. */
  private constant HIT_SEARCH_MARGIN = 3.

  private function checkCollision()
    if onHit3 != null
      forUnitsInRange(pos.toVec2(), radius + HIT_SEARCH_MARGIN * SHEEP_HIT_RADIUS_GROWTH) u ->
        if not done and hitGroup3.size() < maxHits
          checkHit3(u)

  private function hit3(MyUnitEntity target)
    if target.hasShield()
      scaleVel(-1)
    else
      hitGroup3.add(target)
      onHit3.run(target)

  function wasHit(MyUnitEntity e) returns bool
    return hitGroup3.has(e)

  function wasHit(unit u) returns bool
    return hitGroup3.has(u.getMyUnitEntity())
  
  function alignYawAndPitch()
    let yaw = Atan2(vel.y, vel.x).asAngleRadians()
    let pitch = Atan2(-vel.z, vel.toVec2().length()).asAngleRadians()
    setXYAngle(yaw)
    setZAngle(pitch)

  function bounceOfGround() returns bool
    if vel.z.abs() > PROJECTILE_MIN_BOUNCE_SPEED
      scaleVelZ(-conservationBounce)
      scaleVelXY(conservationBounce)
      fx.eff.setTimeScale(0.1)
      soundBounce.playOnPoint(pos)
      return true
    else
      fx.eff.setTimeScale(0.0)
      return false
      
  function bounceOfWalls()
    let z0 = pos.getHeightMap()
    let z1 = (pos + vel).getHeightMap()
    if z1 > z0 and z1 > pos.z + 20
      scaleVelXY(-1)
      soundBounce.playOnPoint(pos)

  ondestroy
    liveProjectiles.remove(this)
    for cb in pendingTimers
      destroy cb
    destroy pendingTimers
    for cb in pendingPeriodics
      destroy cb
    destroy pendingPeriodics
    destroy hitGroup3
    if onHit3 != null
      destroy onHit3
