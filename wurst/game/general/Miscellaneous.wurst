/** Keep in sync with the version in wurst.build. */
public constant VERSION = "1.2.0"
public constant WHATS_NEW_HEADLINE = "Weight class"

/** Player-facing notes for the latest two versions; the full history is in CHANGELOG.md. */
public constant WHATS_NEW = ("Sheepz " + VERSION + ": " + WHATS_NEW_HEADLINE).color(COLOR_GOLD) + "\n\n" +
  "New".color(PINK) + "\n" +
  "- Sheep bounce off each other. Get flung into someone and you both take a hit, and the damage goes to whoever did the flinging. Ram a rival into the sea and the kill is yours.\n" +
  "- Explosions set off explosives. Shoot a mine, a stick of dynamite, a grenade, a cluster bomb or a rocket in flight and it goes off, still owned by whoever put it there. Line three dynamites up and watch the chain go.\n" +
  "- Ticking explosives slow everyone near them. Grenades, cluster bombs, dynamite, armed mines and a landed Holy Hand Grenade drag you to a crawl until they blow. A swelling Baloonicide halves your speed. You are never slowed by your own.\n\n" +
  "- Trees grow back. Blow the scenery apart and it returns a couple of minutes later, so the map stops turning into a bald rock.\n" +
  "- Momentum Reverser. A new weapon that flips the velocity of everything around you: sheep, rockets, grenades and your own fall. Reverse a plunge and you land softly; reverse someone else and they hit the ground hard.\n" +
  "- The Villager Kid can be fought back. Blasts, the Baseball Bat, Fus Ro Dah and the Boomer Hammer send it flying, and enough punishment puts it down for good.\n" +
  "Changed".color(PINK) + "\n" +
  "- Size is weight. The bigger the sheep, the less a blast shifts it, so the kill leader gets harder to move as they level. A fully swollen Baloonicide barely budges.\n" +
  "- Big sheep are easier to hit. A grown sheep has a hitbox to match.\n" +
  "- Every blast sets explosives off, hard landings and Bladestorm waves included.\n\n" +
  "Sheepz 1.1.0: Physics got real".color(COLOR_GOLD) + "\n\n" +
  "Changed".color(PINK) + "\n" +
  "- Falling hurts more. Hard landings deal about 10% more damage and start from slightly lower heights. Choose your jet pack moments wisely.\n" +
  "- Cliffs are solid. Getting blasted into a cliff stops you at the cliff face instead of launching you on top of it.\n" +
  "- Smooth hills. Sheep walk down slopes instead of hopping, at their normal speed.\n" +
  "- Water puts out fire. Shallow water extinguishes a burning sheep too. You still only drown in deep water.\n" +
  "- Explosions land where they hit. Rockets, grenades and friends explode right on the ground instead of just below it.\n\n" +
  "New".color(PINK) + "\n" +
  "- What's New in the quest log, and a pointer to it when the game starts."

DynamicCellValue<int> array[24] LIVES
DynamicCellValue<int> array[24] POINTS

public function player.getLives() returns int
  return LIVES[this.getId()].value

public function player.getPoints() returns int
  return POINTS[this.getId()].value

public function player.setLives(int value)
  // In TIMED mode the Lives cell is never attached to the board (cell == null);
  // lives are still tracked as a plain value there.
  let lives = LIVES[this.getId()]
  if lives.cell != null
    lives.updateValue(value)
  else
    lives.value = value

public function player.setPoints(int value)
  POINTS[this.getId()].updateValue(value)

public function player.addLives(int value)
  this.setLives(this.getLives() + value)

public function player.addPoints(int value)
  this.setPoints(this.getPoints() + value)

public function initMultiboard()
  let board = new Board("Sheepz (Deluxe Edition)".color(PINK), 0.2)
  
  let columns = asList(
    new BoardColumn("Player".color(COLOR_GOLD), 0.4),
    new BoardColumn("Points".color(COLOR_GOLD), 0.3)
  )
  if GAME_MODE == GameMode.SURVIVAL
    columns.add(new BoardColumn("Lives".color(COLOR_GOLD), 0.3))

  board.columns(columns)

  for ii = 0 to MAX_PLAYERS - 1
    let p = players[ii]
    if getPlayersIngame().has(p) or isSinglePlayer()
      POINTS[ii] = dynamicCell<int>(0, i -> i.toString())
      LIVES[ii] = dynamicCell<int>(SHEEP_MAX_LIVES, i -> i.toString())
      let row = board.addRow()
        ..addCell(p.getName())
        ..addDynamic(POINTS[ii])
      // Only SURVIVAL has a Lives column; attaching a third cell to a
      // 2-column board writes out of range.
      if GAME_MODE == GameMode.SURVIVAL
        row.addDynamic(LIVES[ii])

  board.show()


public function addListenersChat()
  EventListener.add(EVENT_PLAYER_CHAT_FILTER) ->
    if EventData.getChatMessage() == "1"
      SOUND_NOOO.play().snd.setVolume(70)
    else if EventData.getChatMessage() == "2"
      SOUND_LAUGH.play().snd.setVolume(80)
    else if EventData.getChatMessage() == "3"
      SOUND_MWAHAHAHA.play().snd.setVolume(80)
    else if EventData.getChatMessage() == "4"
      SOUND_YEET.play().snd.setVolume(30)
    else if EventData.getChatMessage() == "5"
      SOUND_WOLOLO.play().snd.setVolume(80)
    else if EventData.getChatMessage() == "6"
      SOUND_ILL_BE_BACK.play().snd.setVolume(80)
    else if EventData.getChatMessage() == "7"
      SOUND_SPARTA.play().snd.setVolume(70)
    else if EventData.getChatMessage() == "8"
      SOUND_NEED_HEALING.play().snd.setVolume(80)
    else if EventData.getChatMessage() == "9"
      SOUND_GOLD_PLEASE.play().snd.setVolume(80)
    else if EventData.getChatMessage() == "10"
      SOUND_AIRHORN.play().snd.setVolume(30)
    else if EventData.getChatMessage() == "11"
      SOUND_WHOS_YOUR_DADDY.play().snd.setVolume(30)
    else if EventData.getChatMessage() == "12"
      SOUND_YOU_ARE_AN_IDIOT.play().snd.setVolume(40)
    else if EventData.getChatMessage() == "13"
      SOUND_SMEAGOL.play()
    else if EventData.getChatMessage() == "14"
      SOUND_DUNE_WOMAN_2.play().snd.setVolume(60)
    else if EventData.getChatMessage() == "15"
      SOUND_CHICKEN_NUGGETS.play().snd.setVolume(80)
    else if EventData.getChatMessage() == "16"
      SOUND_GREAT_CRIME.play().snd.setVolume(40)

    if EventData.getChatMessage() == "?"
      EventData.getTriggerPlayer().print("\n" + HOW_TO_PLAY, 15)


public function addQuests()
  new Quest(true)
  ..setTitle("Welcome!")
  ..setIcon(Icons.bTNSheep)
  ..setDescription( 
    SLOGAN + "\n\n" + 
    "Collect weapons and obliterate the competition."
  )

  new Quest(true)
  ..setTitle("What's New")
  ..setIcon(Icons.bTNScroll)
  ..setDescription(WHATS_NEW)

  new Quest(true)
  ..setTitle("How to Play")
  ..setIcon(Icons.bTNCritterChicken)
  ..setDescription(HOW_TO_PLAY)

  new Quest(true)
  ..setTitle("Lore")
  ..setIcon(Icons.bTNSpellBookBLS)
  ..setDescription( 
    "1983. In a parallel universe where the Nazi's conquered the world, genetic manipulation of common lifestock has become a sign of masculinity. " +
    "A communist sheep revolution has the Nazi overlords sent to the dark side of the moon. This leaves one final question. Who is the most equal of them all?"
  )
  
  new Quest(false)
  ..setTitle("Credits")
  ..setIcon(Icons.bTNCritterRabbit)
  ..setDescription(
    "WurstScript: Frotty\n".color(LEGENDARY) +
    "Lead testing: SuperPear, HolyHenk\n".color(EPIC) +
    "Testing: MzHyde, PhrasPerNL\n".color(RARE) +
    "\n" +
    "Worms Model Pack: Lord-T-Rex\n".color(UNCOMMON) +
    "Parachute: Fingolfin\n".color(UNCOMMON) +
    "Riot Shield: Tr!KzZ\n".color(UNCOMMON) +
    "Baseball Bat: Kitabatake\n".color(UNCOMMON) +
    "Bladestorm: Waldbaer & Donut 3.5\n".color(UNCOMMON)
  )
