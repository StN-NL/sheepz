package GameStart
import ConfigWeapons
import ClosureTimers
import ConfigGame
import DraftWeapon
import EntityManagement
import GameEnd
import MenuFrame
import Miscellaneous
import MyAssets
import SheepEntity
import Utils
import Weapons

constant GAME_START_DELAY = 1.

init
  doAfter(0.025) ->
    updateMap(-8, 8, 12, 12, Minimaps.tropicalIsland)
    FogMaskEnableOff()
    FogEnableOff()
    initWeapons()
    addListenersChat()
    addQuests()
    startEntityLoop()
    new MenuSetup() -> 
      printWelcome()
      initMultiboard()
      initWeaponDraft()
      enableGameEndCondition()
      setupPlayers()
      addLeaveListener()


function printWelcome()
  print(SLOGAN, 5)
  print("\nFor more information, visit the quest log.", 10)
  print("\nType \"?\" for help", 30)


function setupPlayers()
  for p in getPlayersIngame()
    setupPlayer(p)
    
  if isSinglePlayer()
    targetPractice()


function setupPlayer(player p)
  doAfter(GetRandomReal(0, GAME_START_DELAY)) -> 
    new SheepEntity(p)

    doAfter(GAME_START_DELAY) -> 
      p.addStartingWeapons()


function targetPractice()
  // Five dummies in the first free slots; the human's own slot would get a second sheep.
  var dummies = 0
  for ii = 0 to MAX_PLAYERS - 1
    let p = players[ii]
    if dummies < 5 and not getPlayersIngame().has(p)
      dummies++
      doAfter(GetRandomReal(0, GAME_START_DELAY)) ->
        new SheepEntity(p)


function addLeaveListener()
  // Not onPlayerLeave: it holds a single listener and would replace Utils' one.
  EventListener.add(EVENT_PLAYER_LEAVE) ->
    let p = GetTriggerPlayer()
    if p.getSheep() != null
      p.getSheep().terminate()
