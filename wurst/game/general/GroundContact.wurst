package GroundContact
import Entity
import GameMath
import Heightmap

/** Ground handling for Sheepz bodies, in place of Frentity's PhysicsModule. Contact is resolved
    right after the move, at the point where the body reached the ground, so nothing spends a
    tick below the surface. The contact callbacks see the impact velocity; surface friction
    is applied after them.

    On the ground means just below the surface (terrain - 0.01), matching Entity.update, which
    adds gravity from the surface up. */
public module GroundContactModule
  real terrainZ = 0.
  /** How far a body on the ground follows the terrain down per tick (see staysGrounded). */
  real stickDistance = 0.

  function onGroundHit()

  function onEscapeGround()

  /** Call once per tick, right after the entity moved from `start`. */
  function updateGroundContact(Entity e, vec3 start)
    if e.done or not e.active
      return
    let pos = e.getPos()
    terrainZ = pos.getHeightMap()
    let heightBefore = start.z - start.getHeightMap()
    let heightAfter = pos.z - terrainZ
    switch contactCase(heightBefore, heightAfter, e.getVel().z, stickDistance)
      case LANDED
        // Continue from where it reached the ground during this move.
        let t = contactFraction(heightBefore, heightAfter)
        let contact = (start + (pos - start) * t).toVec2()
        terrainZ = contact.getHeightMap()
        e.setXY(contact.withZ(terrainZ))
        e.flying = false
        onGroundHit()
        // onGroundHit may have terminated the entity (e.g. an exploding projectile).
        if not e.done
          e.scaleVel(SURFACE_FRICTION)
          settle(e)
      case ON_GROUND
        e.scaleVel(SURFACE_FRICTION)
        settle(e)
      case LEFT_GROUND
        e.flying = true
        if e.getVel().z > 0
          onEscapeGround()
      case IN_AIR
        skip

  /** Rests a body on the ground, or leaves it on the surface when it's moving up (a bounce). */
  private function settle(Entity e)
    let vel = e.getVel()
    if vel.z <= 0
      e.flying = false
      e.setXY(e.getPos().toVec2().withZ(terrainZ - 0.01))
      // Resting: drop the gravity Entity.update added when a step down made it look airborne.
      if vel.z < 0
        e.setVel(vec3(vel.x, vel.y, 0))
    else
      e.setXY(e.getPos().toVec2().withZ(terrainZ))
