package ChickenBomb
import Assets
import ClosureTimers
import ConfigWeapons
import MyAssets
import MyProjectile
import SheepEntity
import TextTagEntity


/** An unarmed chicken arms itself after this long, so it can't lie around forever. */
constant CHICKEN_MAX_UNARMED_TIME = 30.

public class ChickenBomb extends MyProjectile
  let baseAttachmentPoint = vec3(0, 0, 50)
  int countdown = chickenBomb.delay.toInt()
  unit buddy = null
  bool armed = false

  construct(SheepEntity source)
    super(source, chickenBomb.minRadius, Units.easterChicken1)
    soundBounce = SOUNDS_CHICKEN.getRandomElement()
    scaleVelXY(0.8)

    onHit3D() target ->
      if not armed
        buddy = target.actor
        arm()

    doAfterAlive(CHICKEN_MAX_UNARMED_TIME) ->
      if not armed
        arm()

    onEnd() ->
      explode()

  function arm()
    armed = true
    SOUNDS_CHICKEN.getRandomElement().playOnPoint(pos)
    doPeriodicallyAlive(1.0) cb ->
      if countdown == 0
        stopTimer(cb)
        if not done
          terminate()
      else
        SOUNDS_CHICKEN.getRandomElement().playOnPoint(pos)
        SOUND_COUNTDOWN.playOnPoint(pos)
        new TextTagEntity(pos, vec3(0, 0, 8), countdown.toString(), 10, 1, colorA(255,0,0,255))
        countdown -= 1

      // if countdown == 1
      //   SOUND_CHICKEN_NUGGETS.playOnPoint(pos)

  override function update()
    bounceOfWalls()
    super.update()
    if buddy != null
      if buddy.isAlive() and (not buddy.isSheep() or buddy.getSheep().isAlive())
        setPos(getAttachmentPoint())
      else
        // The buddy died or was removed from the game; stop tracking so the
        // bomb doesn't snap to a garbage position from a stale handle, or follow
        // a dead sheep (whose unit stays alive) up to heaven.
        buddy = null

  function getAttachmentPoint() returns vec3
    return buddy.getPos3Real() + baseAttachmentPoint

  override function onGroundHit()
    bounceOfGround()
    super.onGroundHit()

  function explode()
    fx.eff.setScale(1.6)
    fx.eff.setTimeScale(1)
    SOUNDS_EXPLOSION.getRandomElement().playOnPoint(pos)
    flashEffect(Objects.toonBoom, pos, 3)
    source.blastArea(pos, chickenBomb.minRadius, chickenBomb.maxRadius, chickenBomb.maxDamage)
