package GameMath
import LinkedList

// Pure, native-free helpers extracted so they can be unit tested (see GameMathTest).

/** Linear blast falloff: 1.0 at or within minRadius, 0.0 at or beyond maxRadius,
    linearly interpolated in between. Safe when minRadius >= maxRadius (no divide by zero). */
public function blastFalloff(real distance, real minRadius, real maxRadius) returns real
  if distance <= minRadius
    return 1.
  else if distance >= maxRadius
    return 0.
  else
    return 1. - (distance - minRadius) / (maxRadius - minRadius)

/** Greedy binary decomposition for the bonus ability system: returns a bitmask where
    bit n set means the 2^n ability applies, matching the 16 doubling bonus abilities
    in Status. Fractional leftovers are dropped and a negative value yields 0
    (no debuff support). */
public function bonusBits(real value) returns int
  var bits = 0
  var remainder = value
  var divisor = 32768 // 2^15
  for exp = 15 downto 0
    if divisor.toReal() <= remainder
      remainder -= divisor.toReal()
      bits += divisor
    divisor = divisor div 2
  return bits

/** Given integer weights and a roll in [0, sum(weights) - 1], returns the index of the
    selected element using cumulative weighting, or -1 if the roll is out of range. */
public function pickWeightedIndex(LinkedList<int> weights, int roll) returns int
  var cumulative = 0
  var index = 0
  var result = -1
  for w in weights
    cumulative += w
    if result == -1 and cumulative > roll
      result = index
    index++
  return result

/** Velocity multiplier per tick while a body touches the ground; applied after the contact response. */
public constant SURFACE_FRICTION = 0.9

/** Sheep landing bounce. The speed threshold was tuned when friction still ran before the bounce. */
public constant SHEEP_BOUNCE_RESTITUTION = 0.5
public constant SHEEP_MIN_BOUNCE_SPEED = 3. / SURFACE_FRICTION

/** Projectiles hitting the ground faster than this bounce; slower ones stop bouncing.
    Tuned when friction still ran before the bounce. */
public constant PROJECTILE_MIN_BOUNCE_SPEED = 6. / SURFACE_FRICTION

/** Vertical speed after hitting the ground at impactVelZ (negative = falling): bounces back
    scaled by restitution when falling faster than minBounceSpeed, otherwise stops. */
public function bounceVelZ(real impactVelZ, real restitution, real minBounceSpeed) returns real
  return impactVelZ < -minBounceSpeed ? -restitution * impactVelZ : 0.

/** How far a unit on the ground follows the terrain down in one tick; a bigger drop is a ledge
    it falls off. Covers walking down slopes at full speed (522/s is about 16 per tick). */
public constant UNIT_STICK_DISTANCE = 20.

/** Fraction (0-1) of a tick's move at which a body reached the ground, given its height above
    the ground before the move (at least 0) and after it (below 0). */
public function contactFraction(real heightBefore, real heightAfter) returns real
  let drop = heightBefore - heightAfter
  if drop <= 0
    return 1.
  return max(0., min(1., heightBefore / drop))

/** Whether a body that was on the ground stays on it after moving to heightAbove above the
    ground: it follows the terrain down, unless launched upward or dropping off a ledge. */
public function staysGrounded(real heightAbove, real velZ, real stickDistance) returns bool
  return velZ <= 0 and heightAbove <= stickDistance

/** Mass of a body from its model scale: 1.0 at the base scale, growing with exponent.
    Exponent 0 turns size-based mass off (everything weighs 1). */
public function massFromScale(real scale, real baseScale, real exponent) returns real
  return (scale / baseScale).pow(exponent)

/** Hit distance of a projectile against a body of the given scale: the projectile's own radius
    at the base scale, growing with the body so bigger sheep can be hit from further out. */
public function hitRadius(real radius, real scale, real baseScale, real growth) returns real
  return radius + growth * (scale / baseScale - 1)

/** Velocity along the contact line after an elastic collision with restitution, for the body
    with mass m moving at un against one with mass mOther at uOtherN. Call it once per body
    with the arguments swapped. At equal mass and restitution 1 the two bodies swap speeds. */
public function bounceVelN(real un, real uOtherN, real m, real mOther, real restitution) returns real
  return (m * un + mOther * uOtherN - mOther * restitution * (un - uOtherN)) / (m + mOther)

/** Impact damage of a collision, mirroring fall damage: nothing up to minSpeed, then linear. */
public function collisionDamage(real closingSpeed, real minSpeed, real factor) returns real
  return max(0., factor * (closingSpeed - minSpeed))

/** Movement speed after a slow zone: slowPct is the fraction taken off, clamped to 0-1. */
public function slowedSpeed(real speed, real slowPct) returns real
  return speed * (1 - max(0., min(1., slowPct)))

/** Terrain rising more than CLIFF_STEP_HEIGHT above a unit within CLIFF_LOOKAHEAD ahead of it is
    a wall: cliffs, and hills too steep to climb. */
public constant CLIFF_STEP_HEIGHT = 30.
public constant CLIFF_LOOKAHEAD = 50.

/** How far to push a unit back from a wall, given the ground height CLIFF_LOOKAHEAD ahead of it
    and its own height: 0 when there's no wall. */
public function cliffPushback(real groundAhead, real z) returns real
  return max(0., (groundAhead - z - CLIFF_STEP_HEIGHT) / 10)

/** How a body's contact with the ground changed over one move. */
public enum ContactCase
  IN_AIR
  LANDED
  ON_GROUND
  LEFT_GROUND

/** Classifies one move from the body's height above the ground at the start of the move (below
    0 means it was on the ground) and at the end. Judged from the start position itself, not
    Frentity's flying flag: for units that flag is set after the walk has already moved them. */
public function contactCase(real heightBefore, real heightAfter, real velZ, real stickDistance) returns ContactCase
  if heightBefore >= 0
    return heightAfter < 0 ? ContactCase.LANDED : ContactCase.IN_AIR
  if heightAfter < 0 or staysGrounded(heightAfter, velZ, stickDistance)
    return ContactCase.ON_GROUND
  return ContactCase.LEFT_GROUND
